{
  "name": "@guideflow/mcp",
  "version": "0.2.0",
  "description": "GuideFlow MCP server — expose tour authoring and validation as tools for any MCP client",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "product-tour",
    "user-onboarding",
    "guideflow",
    "agentic-authoring",
    "mcp-server"
  ],
  "author": "John Mugabe (https://github.com/RealNerdZW)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RealNerdZW/GuideFlow.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/RealNerdZW/GuideFlow#readme",
  "bugs": "https://github.com/RealNerdZW/GuideFlow/issues",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "guideflow-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/fsx.mjs rm dist && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "clean": "node ../../scripts/fsx.mjs rm dist .turbo"
  },
  "dependencies": {
    "@guideflow/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
