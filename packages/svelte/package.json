{
  "name": "@guideflow/svelte",
  "version": "0.2.0",
  "description": "GuideFlow Svelte adapter — a reactive tour store (no components)",
  "keywords": [
    "guided-tour",
    "svelte",
    "product-tour",
    "onboarding",
    "guideflow",
    "walkthrough",
    "tooltip",
    "user-onboarding",
    "svelte-store",
    "sveltekit"
  ],
  "author": "John Mugabe (https://github.com/RealNerdZW)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RealNerdZW/GuideFlow.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/RealNerdZW/GuideFlow#readme",
  "bugs": "https://github.com/RealNerdZW/GuideFlow/issues",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "clean": "node ../../scripts/fsx.mjs rm dist .turbo"
  },
  "peerDependencies": {
    "@guideflow/core": ">=0.1.9 <1.0.0",
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@guideflow/core": "workspace:*",
    "happy-dom": "^13.6.2",
    "svelte": "^4.2.12",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
