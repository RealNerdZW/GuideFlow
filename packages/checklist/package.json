{
  "name": "@guideflow/checklist",
  "version": "0.2.0",
  "description": "GuideFlow onboarding checklist — a persistent, accessible task list built on the tour engine",
  "keywords": [
    "onboarding-checklist",
    "product-tour",
    "user-onboarding",
    "guideflow",
    "getting-started",
    "activation",
    "checklist",
    "onboarding"
  ],
  "author": "John Mugabe (https://github.com/RealNerdZW)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RealNerdZW/GuideFlow.git",
    "directory": "packages/checklist"
  },
  "homepage": "https://github.com/RealNerdZW/GuideFlow#readme",
  "bugs": "https://github.com/RealNerdZW/GuideFlow/issues",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./widget": {
      "import": {
        "types": "./dist/widget/index.d.ts",
        "default": "./dist/widget/index.js"
      },
      "require": {
        "types": "./dist/widget/index.d.cts",
        "default": "./dist/widget/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/fsx.mjs rm dist && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "clean": "node ../../scripts/fsx.mjs rm dist .turbo"
  },
  "peerDependencies": {
    "@guideflow/core": ">=0.1.9 <1.0.0"
  },
  "devDependencies": {
    "@guideflow/core": "workspace:*",
    "happy-dom": "^13.6.2",
    "tsup": "^8.0.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
