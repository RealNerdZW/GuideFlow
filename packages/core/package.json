{
  "name": "@guideflow/core",
  "version": "0.1.9",
  "description": "GuideFlow core engine — framework-agnostic, zero dependencies",
  "keywords": [
    "guided-tour",
    "product-tour",
    "onboarding",
    "spotlight",
    "guideflow",
    "walkthrough",
    "tooltip",
    "user-onboarding",
    "step-by-step",
    "fsm",
    "state-machine"
  ],
  "author": "John Mugabe (https://github.com/RealNerdZW)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RealNerdZW/GuideFlow.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/RealNerdZW/GuideFlow#readme",
  "bugs": "https://github.com/RealNerdZW/GuideFlow/issues",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./global": {
      "default": "./dist/index.global.js"
    },
    "./styles": {
      "import": "./dist/styles/index.css"
    },
    "./styles/*": {
      "import": "./dist/styles/*"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/fsx.mjs cp src/styles dist/styles",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "clean": "node ../../scripts/fsx.mjs rm dist coverage .turbo",
    "size": "size-limit"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.0.2",
    "@types/node": "^20.11.20",
    "happy-dom": "^13.6.2",
    "size-limit": "^11.0.2",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "size-limit": [
    {
      "name": "core entry (tree-shaken)",
      "path": "./dist/index.js",
      "limit": "13 kB",
      "gzip": true
    }
  ],
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js"
}
