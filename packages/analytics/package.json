{
  "name": "@guideflow/analytics",
  "version": "0.2.0",
  "description": "Analytics, A/B testing, and event transport for GuideFlow.js",
  "keywords": [
    "guided-tour",
    "analytics",
    "product-tour",
    "guideflow",
    "ab-testing",
    "posthog",
    "mixpanel",
    "amplitude",
    "segment",
    "event-tracking",
    "experiment"
  ],
  "author": "John Mugabe (https://github.com/RealNerdZW)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RealNerdZW/GuideFlow.git",
    "directory": "packages/analytics"
  },
  "homepage": "https://github.com/RealNerdZW/GuideFlow#readme",
  "bugs": "https://github.com/RealNerdZW/GuideFlow/issues",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "clean": "node ../../scripts/fsx.mjs rm dist .turbo"
  },
  "peerDependencies": {
    "@guideflow/core": ">=0.1.9 <1.0.0"
  },
  "devDependencies": {
    "@guideflow/core": "workspace:*",
    "happy-dom": "^13.6.2",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.1"
  }
}
