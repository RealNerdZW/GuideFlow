{
  "name": "@guideflow/devtools",
  "version": "0.2.0",
  "description": "Browser DevTools extension for GuideFlow.js — visual tour builder and flow inspector",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "clean": "node ../../scripts/fsx.mjs rm dist .turbo",
    "test": "vitest run",
    "package": "node ../../scripts/pack-extension.mjs"
  },
  "dependencies": {
    "@guideflow/core": "workspace:*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "happy-dom": "^13.6.2",
    "typescript": "^7.0.2",
    "vite": "^5.2.0",
    "vitest": "^4.1.10"
  },
  "author": "John Mugabe (https://github.com/RealNerdZW)",
  "homepage": "https://github.com/RealNerdZW/GuideFlow#readme",
  "bugs": "https://github.com/RealNerdZW/GuideFlow/issues",
  "files": [
    "dist",
    "src",
    "manifest.json",
    "store",
    "README.md"
  ]
}
