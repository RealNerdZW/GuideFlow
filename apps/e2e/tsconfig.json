{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node",
      "chrome"
    ],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  },
  "include": [
    "tests/**/*.ts",
    "tests-extension/**/*.ts",
    "playwright.config.ts",
    "global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}
