{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      // `build` (own package) as well as `^build` (dependencies), for the same
      // reason lint and type-check below carry it — and MEASURED here, three
      // times in one session, as three different packages "failing".
      //
      // Two suites read their OWN package's dist: @guideflow/mcp's
      // stdio-smoke.test.ts SPAWNS `dist/index.js`, and @guideflow/devtools'
      // store-readiness.test.ts reads `dist/manifest.json` and the icon PNGs.
      // Every package's build starts with `fsx rm dist`, so with `^build` alone
      // turbo is free to schedule a package's test alongside its own build —
      // and the test loses the race against the rm. It presents as an
      // intermittent, unrelated-looking failure in whichever package was
      // scheduled first, which is exactly the shape that gets waved through as
      // "flaky CI".
      "dependsOn": ["^build", "build"],
      "outputs": ["coverage/**"],
      // TEMP/TMP/TMPDIR as well as CI: turbo filters the environment, and on
      // Windows `os.tmpdir()` reads TEMP then TMP before falling back. With
      // neither passed through it returns the string "undefined\temp", so
      // `mkdtempSync(join(tmpdir(), …))` fails with ENOENT — inside turbo only,
      // which makes it look like a flaky test rather than a config gap.
      // @guideflow/mcp's sandbox tests are the first here to need a temp dir.
      "passThroughEnv": ["CI", "TEMP", "TMP", "TMPDIR"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": ["test-results/**", "playwright-report/**"],
      "passThroughEnv": ["CI"]
    },
    "lint": {
      // ESLint runs type-aware rules (parserOptions.project), so it resolves
      // imports through each dependency's emitted .d.ts. Without ^build a
      // cold-cache lint races the builds it depends on and fails in whichever
      // package happens to be scheduled first — intermittently, which is worse
      // than failing every time. Found by the Phase 4 docs verification.
      //
      // `build` (own package) as well as `^build` (dependencies), because a
      // package can resolve its OWN types by package name: packages/core's
      // fixture-guard test imports apps/e2e/fixtures/flows.d.ts, which imports
      // `@guideflow/core` — resolved through package.json `types` to
      // `dist/index.d.ts`. Core has no workspace dependencies, so `^build` is
      // empty for it, and its lint raced its own `fsx rm dist`. That surfaced
      // as `no-unsafe-member-access` on an "error typed value" in whichever
      // file happened to be reading dist when it vanished.
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "type-check": {
      // Same race, same reason — tsc resolves the identical self-reference.
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "size": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
